{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://inward-eyes.local/schemas/discovery_log.schema.json",
  "title": "DiscoveryLog",
  "type": "object",
  "required": [
    "schema_version",
    "task_type",
    "research_question",
    "discovery_mode",
    "max_sources",
    "hard_max_sources",
    "allowed_domains",
    "allowed_source_types",
    "excluded_domains",
    "excluded_source_types",
    "search_queries",
    "selection_rationale_required",
    "public_only",
    "recursive_links_followed",
    "generated_at",
    "candidates",
    "selected_sources",
    "warnings"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "task_type": {
      "type": "string",
      "const": "browser-research-discovery"
    },
    "research_question": {
      "type": "string",
      "minLength": 1
    },
    "discovery_mode": {
      "type": "string",
      "enum": [
        "candidate_list",
        "search_results"
      ]
    },
    "max_sources": {
      "type": "integer"
    },
    "hard_max_sources": {
      "type": "integer"
    },
    "allowed_domains": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "allowed_source_types": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "excluded_domains": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "excluded_source_types": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "recency": {
      "type": [
        "object",
        "string",
        "null"
      ]
    },
    "search_queries": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "selection_rationale_required": {
      "type": "boolean"
    },
    "public_only": {
      "type": "boolean"
    },
    "recursive_links_followed": {
      "type": "boolean"
    },
    "generated_at": {
      "type": "string",
      "minLength": 1
    },
    "candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "candidate_id",
          "query",
          "url",
          "status",
          "reason",
          "timestamp"
        ],
        "properties": {
          "candidate_id": {
            "type": "string"
          },
          "query": {
            "type": "string"
          },
          "url": {
            "type": "string"
          },
          "title": {
            "type": [
              "string",
              "null"
            ]
          },
          "snippet": {
            "type": [
              "string",
              "null"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "accepted",
              "rejected"
            ]
          },
          "reason": {
            "type": "string"
          },
          "timestamp": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    },
    "selected_sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "source_id",
          "candidate_id",
          "url",
          "title",
          "source_type",
          "selection_rationale"
        ],
        "properties": {
          "source_id": {
            "type": "string"
          },
          "candidate_id": {
            "type": "string"
          },
          "url": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "source_type": {
            "type": "string"
          },
          "selection_rationale": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": true
}
