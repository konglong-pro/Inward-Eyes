{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://inward-eyes.local/schemas/page_to_md_metadata.schema.json",
  "title": "PageToMarkdownMetadata",
  "type": "object",
  "required": [
    "schema_version",
    "task_type",
    "source",
    "document",
    "extraction",
    "assets"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "task_type": {
      "const": "page-to-md"
    },
    "source": {
      "type": "object",
      "required": [
        "url",
        "page_title",
        "accessed_at",
        "requires_login"
      ],
      "properties": {
        "url": {
          "type": "string",
          "minLength": 1
        },
        "canonical_url": {
          "type": [
            "string",
            "null"
          ]
        },
        "page_title": {
          "type": [
            "string",
            "null"
          ]
        },
        "site_name": {
          "type": [
            "string",
            "null"
          ]
        },
        "accessed_at": {
          "type": "string",
          "minLength": 1
        },
        "requires_login": {
          "type": "boolean"
        }
      }
    },
    "document": {
      "type": "object",
      "required": [
        "title",
        "author",
        "published_at",
        "language",
        "page_type"
      ],
      "properties": {
        "title": {
          "$ref": "#/$defs/confidence_field"
        },
        "author": {
          "$ref": "#/$defs/confidence_field"
        },
        "published_at": {
          "$ref": "#/$defs/confidence_field"
        },
        "language": {
          "type": [
            "string",
            "null"
          ]
        },
        "page_type": {
          "type": "string"
        }
      }
    },
    "extraction": {
      "type": "object",
      "required": [
        "method",
        "tool_chain",
        "excluded_blocks",
        "warnings",
        "screenshot_policy"
      ],
      "properties": {
        "method": {
          "type": "string",
          "minLength": 1
        },
        "tool_chain": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "excluded_blocks": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "screenshot_policy": {
          "type": "object"
        }
      }
    },
    "assets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "type",
          "path",
          "captured_at"
        ],
        "properties": {
          "type": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "captured_at": {
            "type": "string"
          }
        }
      }
    }
  },
  "$defs": {
    "confidence_field": {
      "type": "object",
      "required": [
        "value",
        "confidence",
        "evidence"
      ],
      "properties": {
        "value": {
          "type": [
            "string",
            "null"
          ]
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "evidence": {
          "type": "string"
        }
      }
    }
  },
  "additionalProperties": true
}
