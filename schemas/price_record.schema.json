{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://inward-eyes.local/schemas/price_record.schema.json",
  "title": "PriceRecord",
  "type": "object",
  "required": [
    "quote_id",
    "source_id",
    "url",
    "platform",
    "region",
    "currency",
    "product_identity",
    "seller",
    "condition",
    "stock",
    "prices",
    "match_confidence",
    "selected_specs_confirmed",
    "flags",
    "screenshot_policy",
    "screenshot",
    "anomalies",
    "eligible_for_lowest_price"
  ],
  "properties": {
    "quote_id": {
      "type": "string",
      "minLength": 1
    },
    "candidate_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "source_id": {
      "type": "string",
      "minLength": 1
    },
    "source_record_path": {
      "type": "string"
    },
    "url": {
      "type": "string",
      "minLength": 1
    },
    "canonical_url": {
      "type": [
        "string",
        "null"
      ]
    },
    "title": {
      "type": [
        "string",
        "null"
      ]
    },
    "platform": {
      "type": "string"
    },
    "region": {
      "type": "string"
    },
    "currency": {
      "type": "string"
    },
    "accessed_at": {
      "type": "string"
    },
    "product_identity": {
      "type": "object",
      "required": [
        "product_name",
        "specs"
      ],
      "properties": {
        "product_name": {
          "type": "string"
        },
        "model_number": {
          "type": [
            "string",
            "null"
          ]
        },
        "specs": {
          "type": "object"
        }
      },
      "additionalProperties": true
    },
    "seller": {
      "type": "string"
    },
    "seller_type": {
      "type": "string"
    },
    "condition": {
      "type": "string"
    },
    "stock": {
      "type": "string"
    },
    "prices": {
      "type": "object",
      "required": [
        "list_price",
        "sale_price",
        "coupon_price",
        "shipping_fee",
        "estimated_total"
      ],
      "properties": {
        "list_price": {
          "type": [
            "number",
            "null"
          ]
        },
        "sale_price": {
          "type": [
            "number",
            "null"
          ]
        },
        "coupon_price": {
          "type": [
            "number",
            "null"
          ]
        },
        "shipping_fee": {
          "type": [
            "number",
            "null"
          ]
        },
        "estimated_total": {
          "type": [
            "number",
            "null"
          ]
        }
      },
      "additionalProperties": true
    },
    "match_confidence": {
      "type": "number"
    },
    "selected_specs_confirmed": {
      "type": "boolean"
    },
    "flags": {
      "type": "object",
      "required": [
        "coupon_action_required",
        "cart_required",
        "checkout_required",
        "membership_required",
        "address_change_required"
      ],
      "properties": {
        "coupon_action_required": {
          "type": "boolean"
        },
        "cart_required": {
          "type": "boolean"
        },
        "checkout_required": {
          "type": "boolean"
        },
        "membership_required": {
          "type": "boolean"
        },
        "address_change_required": {
          "type": "boolean"
        }
      },
      "additionalProperties": true
    },
    "screenshot_policy": {
      "type": "object"
    },
    "screenshot": {
      "type": [
        "string",
        "null"
      ]
    },
    "comparison_price": {
      "type": [
        "number",
        "null"
      ]
    },
    "eligible_for_lowest_price": {
      "type": "boolean"
    },
    "anomalies": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": true
}
