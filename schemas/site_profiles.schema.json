{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Inward Eyes site profile catalog",
  "type": "object",
  "required": [
    "schema_version",
    "catalog_id",
    "profiles"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "catalog_id": {
      "type": "string",
      "minLength": 1
    },
    "profiles": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "profile_id",
          "profile_version",
          "label",
          "workflows",
          "page_types",
          "content_scope",
          "required_evidence",
          "screenshot_policy",
          "allowed_actions",
          "forbidden_actions",
          "risk_flags"
        ],
        "properties": {
          "profile_id": {
            "type": "string",
            "minLength": 1
          },
          "profile_version": {
            "type": "string",
            "minLength": 1
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "domain_patterns": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "url_patterns": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "site_names": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "workflows": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "page_types": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "content_scope": {
            "type": "object",
            "required": [
              "included",
              "excluded"
            ],
            "properties": {
              "included": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "excluded": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          },
          "required_evidence": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "screenshot_policy": {
            "type": "object",
            "required": [
              "rule"
            ],
            "properties": {
              "rule": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "allowed_actions": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "forbidden_actions": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "risk_flags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
