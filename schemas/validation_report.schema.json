{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://inward-eyes.local/schemas/validation_report.schema.json",
  "title": "ValidationReport",
  "type": "object",
  "required": [
    "schema_version",
    "status",
    "errors",
    "warnings",
    "requires_manual_review",
    "run_status",
    "validation_status",
    "manual_review",
    "completion_blockers"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "pass",
        "fail"
      ]
    },
    "errors": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "requires_manual_review": {
      "type": "boolean"
    },
    "run_status": {
      "type": "string"
    },
    "validation_status": {
      "type": "string"
    },
    "manual_review": {
      "type": "object"
    },
    "completion_blockers": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "screenshot_policy": {
      "type": "object"
    }
  },
  "additionalProperties": true
}
